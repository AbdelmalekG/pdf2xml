		<source>
			<id>2</id>
			<type>1</type>
			<name>detail</name>
			<sql>

				select p.annee, p.mois, p.numero, p.date, p.description, sb.numero as compte,
				e.nom_prenom as nom, ep.rib, convert(numeric(16,2), pd.montant) as montant, s.nom,
				s.adresse, s.postal_code, s.ville, s.idfiscal, s.cnss, s.rc, s.tp,
				bq.nom as banque_societe, sb.agence as banque_societe_agence, sb.adresse as
				banque_societe_adresse
				from paiement_salaire p
				inner join paiement_detail pd on p.id = pd.paiement_id
				inner join v_employe_global e on pd.employe_id = e.employe_id and pd.annee = e.annee and
				pd.mois = e.mois
				left outer join employe_paiement ep on pd.employe_id = ep.employe_id and pd.compte_ligne =
				ep.ligne
				left outer join v_societe_report s on s.id = 1
				left outer join societe_banque sb on p.compte_id = sb.id
				left outer join banque bq on sb.banque_id = bq.id
				where 1=1
				and p.id = :paiement

			</sql>
		</source>
